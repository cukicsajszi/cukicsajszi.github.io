<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="no-referrer-when-downgrade">
<meta name="robots" content="noindex, nofollow">
<title>Titkos világom...</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #0f0f0f;
    color: #f5f5f5;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
  }
  .card { max-width: 380px; width: 100%; }
  .spinner {
    width: 36px; height: 36px;
    border: 3px solid #333;
    border-top-color: #f5f5f5;
    border-radius: 50%;
    margin: 0 auto 20px;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  h1 { font-size: 18px; font-weight: 600; margin-bottom: 8px; }
  a { color: #f5f5f5; }
  .btn {
    display: inline-block;
    background: #f5f5f5;
    color: #0f0f0f;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 14px 28px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    margin: 6px 0;
    width: 100%;
  }
  .steps {
    text-align: left;
    background: #1a1a1a;
    border-radius: 12px;
    padding: 16px 18px;
    margin: 12px 0 20px;
    font-size: 14px;
    color: #ddd;
    line-height: 1.7;
  }
  .steps b { color: #fff; }
  .hidden { display: none; }
  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    background: #f5f5f5;
    color: #0f0f0f;
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }
  .toast.show { opacity: 1; }
</style>
</head>
<body>

<div class="card">
  <div id="loading">
    <div class="spinner"></div>
    <h1>Máris ott vagyunk...</h1>
    <noscript>
      <p><a href="https://www.fanvue.com/nagylili/fv-6">Kattints ide a folytatáshoz</a></p>
    </noscript>
  </div>

  <div id="copyFallback" class="hidden">
    <h1>Ez a link nem nyitható meg itt</h1>
    <div class="steps">
      1. Koppints a <b>⋯</b> ikonra jobb fent<br>
      2. Válaszd: <b>Megnyitás böngészőben</b><br>
      vagy<br>
      3. Másold ki a linket az alábbi gombbal, és illeszd be böngészőbe
    </div>
    <button class="btn" id="copyBtn" type="button">Kattints ide, hogy másold a linket</button>
  </div>
</div>

<div class="toast" id="toast">Link másolva ✓</div>

<script>
  // ---- Tracking links ----------------------------------------------------
  var LINKS = {
    telegram:  "https://www.fanvue.com/nagylili/fv-5",
    twitter:   "https://www.fanvue.com/nagylili/fv-3",
    instagram: "https://www.fanvue.com/nagylili/fv-2",
    tiktok:    "https://www.fanvue.com/nagylili/fv-1",
    fallback:  "https://www.fanvue.com/nagylili/fv-6"   // unknown / normal browser
  };

  // Optional manual override: yourpage.html?s=tg  (tg | x | ig | tt)
  var SOURCE_ALIASES = {
    tg: "telegram", telegram: "telegram",
    x: "twitter", tw: "twitter", twitter: "twitter",
    ig: "instagram", instagram: "instagram",
    tt: "tiktok", tiktok: "tiktok"
  };

  // ---- Detection -----------------------------------------------------------
  function detectSource() {
    // 1) Explicit override via query string (most reliable)
    try {
      var params = new URLSearchParams(window.location.search);
      var s = (params.get("s") || params.get("src") || "").toLowerCase();
      if (SOURCE_ALIASES[s]) return SOURCE_ALIASES[s];
    } catch (e) {}

    // 2) In-app browser user agent
    var ua = navigator.userAgent || navigator.vendor || window.opera || "";

    if (/TikTok|musical_ly|BytedanceWebview|Bytedance|trill/i.test(ua)) return "tiktok";
    if (/Instagram/i.test(ua)) return "instagram";
    if (/Twitter|TwitterAndroid/i.test(ua)) return "twitter";
    if (/Telegram/i.test(ua) || typeof window.TelegramWebviewProxy !== "undefined" ||
        typeof window.TelegramWebview !== "undefined") return "telegram";

    // 3) Referrer (works only if the referrer survives the link.me hop)
    var ref = (document.referrer || "").toLowerCase();
    if (/(^|\/\/|\.)(t\.co|twitter\.com|x\.com)(\/|$)/.test(ref)) return "twitter";
    if (/(^|\/\/|\.)(instagram\.com|l\.instagram\.com)(\/|$)/.test(ref)) return "instagram";
    if (/(^|\/\/|\.)(tiktok\.com)(\/|$)/.test(ref)) return "tiktok";
    if (/(^|\/\/|\.)(t\.me|telegram\.org|web\.telegram\.org)(\/|$)/.test(ref)) return "telegram";

    return "fallback";
  }

  function getPlatform() {
    var ua = navigator.userAgent || "";
    if (/iPhone|iPad|iPod/i.test(ua)) return "ios";
    if (/Android/i.test(ua)) return "android";
    return "desktop";
  }

  // ---- UI helpers ----------------------------------------------------------
  var targetUrl = LINKS.fallback;

  function showCopyFallback() {
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("copyFallback").classList.remove("hidden");
  }

  function showToast() {
    var toast = document.getElementById("toast");
    toast.classList.add("show");
    setTimeout(function () { toast.classList.remove("show"); }, 1800);
  }

  function legacyCopy() {
    var ta = document.createElement("textarea");
    ta.value = targetUrl;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    var ok = false;
    try { ok = document.execCommand("copy"); } catch (e) {}
    document.body.removeChild(ta);
    if (ok) showToast();
    else window.prompt("Másold ki a linket:", targetUrl);
  }

  function copyLink() {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(targetUrl).then(showToast).catch(legacyCopy);
    } else {
      legacyCopy();
    }
  }

  // ---- TikTok: try to break out of the in-app browser ----------------------
  function attemptTikTokEscape(platform, url) {
    var handled = false;
    var noScheme = url.replace(/^https?:\/\//, "");

    window.addEventListener("pagehide", function () { handled = true; });
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) handled = true;
    });

    if (platform === "ios") {
      window.location.href = "x-safari-https://" + noScheme;
    } else if (platform === "android") {
      window.location.href = "intent://" + noScheme +
        "#Intent;scheme=https;package=com.android.chrome;" +
        "S.browser_fallback_url=" + encodeURIComponent(url) + ";end;";
    } else {
      window.location.replace(url);
      return;
    }

    setTimeout(function () {
      if (!handled) showCopyFallback();
    }, 1200);
  }

  // ---- Go ------------------------------------------------------------------
  window.addEventListener("DOMContentLoaded", function () {
    document.getElementById("copyBtn").addEventListener("click", copyLink);

    var source = detectSource();
    targetUrl = LINKS[source] || LINKS.fallback;

    if (source === "tiktok") {
      attemptTikTokEscape(getPlatform(), targetUrl);
      return;
    }
    window.location.replace(targetUrl);
  });
</script>

</body>
</html>
